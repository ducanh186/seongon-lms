\":[\"configuration\",\"vite\",\"vitest\",\"react\",\"tailwind\"],\"complexity\":\"simple\"},\n+    {\"id\":\"function:FE/DEMO/vite.config.ts:figmaAssetResolver\",\"type\":\"function\",\"name\":\"figmaAssetResolver\",\"filePath\":\"FE/DEMO/vite.config.ts\",\"lineRange\":[7,17],\"summary\":\"Tạo plugin Vite ánh xạ import figma:asset sang thư mục src/assets của frontend demo.\",\"tags\":[\"vite\",\"asset-resolution\",\"figma\",\"build-system\"],\"complexity\":\"simple\"},\n+    {\"id\":\"file:Infra/docker/nginx/default.conf\",\"type\":\"file\",\"name\":\"default.conf\",\"filePath\":\"Infra/docker/nginx/default.conf\",\"summary\":\"Cấu hình Nginx phục vụ frontend tĩnh, health check và chuyển tiếp tuyến /api tới PHP-FPM của service app.\",\"tags\":[\"nginx\",\"reverse-proxy\",\"routing\",\"infrastructure\"],\"complexity\":\"simple\"},\n+    {\"id\":\"file:Infra/docker/php/entrypoint.sh\",\"type\":\"file\",\"name\":\"entrypoint.sh\",\"filePath\":\"Infra/docker/php/entrypoint.sh\",\"summary\":\"Entrypoint container PHP chạy migration, seed demo một lần và tối ưu Laravel trước khi thực thi lệnh container.\",\"tags\":[\"docker\",\"laravel\",\"entry-point\",\"deployment\"],\"complexity\":\"simple\"},\n+    {\"id\":\"config:Infra/docker/php/opcache.ini\",\"type\":\"config\",\"name\":\"opcache.ini\",\"filePath\":\"Infra/docker/php/opcache.ini\",\"summary\":\"Thiết lập PHP OPcache cho production với cache bytecode, dung lượng bộ nhớ và vô hiệu hóa kiểm tra timestamp.\",\"tags\":[\"configuration\",\"php\",\"opcache\",\"performance\"],\"complexity\":\"simple\"},\n+    {\"id\":\"file:Infra/tests/verify-production-compose.ps1\",\"type\":\"file\",\"name\":\"verify-production-compose.ps1\",\"filePath\":\"Infra/tests/verify-production-compose.ps1\",\"summary\":\"Kiểm tra Docker Compose production: service bắt buộc, profile phpMyAdmin, port exposure, volume và các action của script vận hành.\",\"tags\":[\"test\",\"powershell\",\"docker-compose\",\"infrastructure\"],\"complexity\":\"moderate\"},\n+    {\"id\":\"file:Infra/tests/verify-run-docker-bootstrap.ps1\",\"type\":\"file\",\"name\":\"verify-run-docker-bootstrap.ps1\",\"filePath\":\"Infra/tests/verify-run-docker-bootstrap.ps1\",\"summary\":\"Xác nhận run-docker.ps1 chứa các thành phần bootstrap Docker Desktop và thông báo điều kiện Windows cần thiết.\",\"tags\":[\"test\",\"powershell\",\"docker\",\"bootstrap\"],\"complexity\":\"simple\"},\n+    {\"id\":\"document:README.md\",\"type\":\"document\",\"name\":\"README.md\",\"filePath\":\"README.md\",\"summary\":\"Hướng dẫn chạy bản demo SEONGON LMS trên Windows, gồm lấy mã nguồn, Docker Desktop, tài khoản dữ liệu demo và xử lý lỗi phổ biến.\",\"tags\":[\"documentation\",\"entry-point\",\"docker\",\"getting-started\"],\"complexity\":\"moderate\"},\n+    {\"id\":\"document:SPEC/Draft.md\",\"type\":\"document\",\"name\":\"Draft.md\",\"filePath\":\"SPEC/Draft.md\",\"summary\":\"Bản thảo chương phân tích và thiết kế SEONGON LMS, mô tả user story, yêu cầu chức năng, use case, activity và sequence diagram cho khách, học viên và quản trị viên.\",\"tags\":[\"documentation\",\"requirements\",\"use-case\",\"lms\"],\"complexity\":\"complex\"},\n+    {\"id\":\"file:SPEC/draft (1).docx\",\"type\":\"file\",\"name\":\"draft (1).docx\",\"filePath\":\"SPEC/draft (1).docx\",\"summary\":\"Tài liệu Word đặc tả bài toán SEONGON LMS với user story và yêu cầu học trực tuyến cho khách, học viên và quản trị viên.\",\"tags\":[\"documentation\",\"requirements\",\"user-story\",\"lms\"],\"complexity\":\"complex\"},\n+    {\"id\":\"file:SPEC/seongon_learning_prototype_v3.html\",\"type\":\"file\",\"name\":\"seongon_learning_prototype_v3.html\",\"filePath\":\"SPEC/seongon_learning_prototype_v3.html\",\"summary\":\"Prototype HTML độc lập mô phỏng nền tảng học Search Marketing, bao phủ trang công khai, học tập, blog và dashboard quản trị.\",\"tags\":[\"prototype\",\"html\",\"lms\",\"frontend\"],\"complexity\":\"complex\"},\n+    {\"id\":\"file:data/state_store.db/mem%3Ahealth.bin\