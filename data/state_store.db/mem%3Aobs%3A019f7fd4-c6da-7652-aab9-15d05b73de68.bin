3036_create_personal_access_tokens_table.php\",\"summary\":\"Tạo bảng personal_access_tokens với quan hệ polymorphic, abilities và thời hạn token cho Laravel Sanctum.\",\"tags\":[\"database\",\"migration\",\"authentication\",\"sanctum\"],\"complexity\":\"simple\"},\n+    {\"id\":\"file:BE/database/migrations/2026_07_10_170001_create_categories_table.php\",\"type\":\"file\",\"name\":\"2026_07_10_170001_create_categories_table.php\",\"filePath\":\"BE/database/migrations/2026_07_10_170001_create_categories_table.php\",\"summary\":\"Tạo bảng categories lưu tên, slug duy nhất, mô tả và timestamps cho danh mục khóa học.\",\"tags\":[\"database\",\"migration\",\"category\",\"schema\"],\"complexity\":\"simple\"},\n+    {\"id\":\"file:BE/database/migrations/2026_07_10_170002_create_courses_table.php\",\"type\":\"file\",\"name\":\"2026_07_10_170002_create_courses_table.php\",\"filePath\":\"BE/database/migrations/2026_07_10_170002_create_courses_table.php\",\"summary\":\"Tạo bảng courses liên kết category và lưu nội dung, giá, giảng viên, level cùng trạng thái xuất bản.\",\"tags\":[\"database\",\"migration\",\"course\",\"schema\"],\"complexity\":\"simple\"},\n+    {\"id\":\"file:BE/database/migrations/2026_07_10_170003_create_lessons_table.php\",\"type\":\"file\",\"name\":\"2026_07_10_170003_create_lessons_table.php\",\"filePath\":\"BE/database/migrations/2026_07_10_170003_create_lessons_table.php\",\"summary\":\"Tạo bảng lessons gắn với course, chứa tiêu đề, video URL, mô tả, thời lượng và thứ tự hiển thị.\",\"tags\":[\"database\",\"migration\",\"lesson\",\"schema\"],\"complexity\":\"simple\"},\n+    {\"id\":\"file:BE/database/migrations/2026_07_10_170004_create_orders_table.php\",\"type\":\"file\",\"name\":\"2026_07_10_170004_create_orders_table.php\",\"filePath\":\"BE/database/migrations/2026_07_10_170004_create_orders_table.php\",\"summary\":\"Tạo bảng orders liên kết user và course, theo dõi số tiền, thanh toán, trạng thái và transaction reference.\",\"tags\":[\"database\"