 Sort-Object Name); if ($partPaths.Count -ne 4) { throw \"Expected 4 batch parts, found $($partPaths.Count)\" }; $allImportTargets = @{}; foreach ($file in $batch.files) { foreach ($target in @($batch.batchImportData.($file.path))) { $allImportTargets[\"file:$target\"] = $true } }; $neighborTargets = @{}; foreach ($property in $batch.neighborMap.PSObject.Properties) { foreach ($neighbor in @($property.Value)) { foreach ($symbol in @($neighbor.symbols)) { $neighborTargets[\"function:$($neighbor.path):$symbol\"] = $true; $neighborTargets[\"class:$($neighbor.path):$symbol\"] = $true } } }; $allNodes = @(); $allEdges = @(); $validationErrors = New-Object System.Collections.Generic.List[string]; foreach ($partFile in $partPaths) { try { $fragment = Get-Content -Raw $partFile.FullName | ConvertFrom-Json -Depth 100 } catch { $validationErrors.Add(\"Invalid JSON: $($partFile.Name): $($_.Exception.Message)\"); continue }; if ($null -eq $fragment.nodes -or $null -eq $fragment.edges) { $validationErrors.Add(\"Missing nodes or edges: $($partFile.Name)\"); continue }; $ids = @{}; foreach ($node in @($fragment.nodes)) { if ($ids.ContainsKey($node.id)) { $validationErrors.Add(\"Duplicate local node $($node.id) in $($partFile.Name)\") }; $ids[$node.id] = $true; if ([string]::IsNullOrWhiteSpace($node.summary) -or @($node.tags).Count -eq 0) { $validationErrors.Add(\"Incomplete node $($node.id)\") } }; foreach ($edge in @($fragment.edges)) { if (-not $ids.ContainsKey($edge.source)) { $validationErrors.Add(\"Invalid source $($edge.source) in $($partFile.Name)\") }; $targetValid = $ids.ContainsKey($edge.target) -or $allImportTargets.ContainsKey($edge.target) -or $neighborTargets.ContainsKey($edge.target); if (-not $targetValid) { $validationErrors.Add(\"Invalid target $($edge.target) in $($partFile.Name)\") } }; $allNodes += @($fragment.nodes); $allEdges += @($fragment.edges) }; $expectedImports = 0; foreach ($file in $batch.files) { $expectedImports += @($batch.batchImportData.($file.p